# Asset Gateway Configuration
# Env vars override file values: ASSET_GATEWAY_<KEY> > config.toml > defaults

[server]
admin_token = ""

[proxy]
url = "https://api.xiaomao.chat"
key = ""
default_model = "claude-sonnet-4-6"

[elevenlabs]
key = ""

[tripo3d]
key = ""

# DashScope (Qwen3-TTS) — International Singapore region
[dashscope]
url = "https://dashscope-intl.aliyuncs.com"
key = ""

# Jimeng video+image (ByteDance) — jimeng-api gateway
[jimeng]
url = "http://127.0.0.1:5100"
token = ""

# WorldLabs Marble — 3D world/environment generation
[worldlabs]
key = ""

# xAI direct API — Grok image + video generation
[xai]
key = ""

# Vertex AI — direct access for Google models (Gemini Image, Lyria, Veo, CharAnim)
[vertex]
service_account_path = "~/vertex-ai-key.json"
project_id = ""
location = "global"
